---
import Experience from "../components/Experience.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Resume | Ciarán Finn"
  description="Resume of Ciarán Finn, principal machine learning engineer."
>
  <p class="back-link">
    <a href="/" aria-label="Back to home">
      ← Home
    </a>
  </p>

  <header class="resume-header">
    <h1>Ciarán Finn</h1>
    <p class="resume-title">Principal Machine Learning Engineer</p>
    <p class="resume-meta">New York, New York, United States</p>
  </header>

  <Experience />

  <section class="experience" aria-labelledby="education-heading">
    <h2 id="education-heading">
      <span class="section-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="m2 9 10-5 10 5-10 5L2 9Zm4 2.1v4.35c0 .68.36 1.31.95 1.66A9.98 9.98 0 0 0 12 18.5c1.84 0 3.57-.5 5.05-1.39c.59-.35.95-.98.95-1.66V11.1l-6 3-6-3ZM19 11.62v4.63h2v-5.63l-2 .99Z"></path>
        </svg>
      </span>
      Education
    </h2>

    <article class="company">
      <header class="company-header">
        <div>
          <h3>
            <a href="https://www.tcd.ie/">Trinity College Dublin</a>
          </h3>
        </div>
      </header>
      <ol class="roles">
        <li>
          <h4>Master in Computer Science (MCS), Computer Science</h4>
          <p class="role-meta">2017 – 2018</p>
          <p class="role-location">Dublin, Ireland</p>
          <p class="role-grade">Grade: Distinction</p>
        </li>
        <li>
          <h4>B.A. (Moderatorship), Computer Science</h4>
          <p class="role-meta">2013 – 2017</p>
          <p class="role-location">Dublin, Ireland</p>
          <p class="role-grade">Grade: First Class Honors</p>
        </li>
      </ol>
    </article>
  </section>
</Layout>
